# Copiar a .streamlit/secrets.toml (local) o pegar en el panel de
# Streamlit Cloud (Settings -> Secrets).
#
# IMPORTANTE: este archivo es solo el ejemplo. El de verdad NUNCA se sube
# al repositorio: esta en el .gitignore.

# Contraseña para entrar a la app. Si se deja vacía no pide login
# (solo aceptable corriendo en tu propia máquina).
suprabond_password = "poner-una-contraseña-larga"


# --- Credenciales de la aplicación de MercadoLibre --------------------
# Las mismas que están en credentials.txt. En la nube van acá porque
# credentials.txt no se sube al repo.
# OJO: tiene que ser la app del panel de MercadoLibre URUGUAY, no la de
# Argentina. Son cuentas y aplicaciones distintas.
[mercadolibre]
app_id = "poner-el-app-id-de-la-app-uy"
secret_key = "poner-la-secret-key"
redirect_uri = "poner-la-misma-que-esta-cargada-en-el-panel"


# --- Google Sheet donde viven el token y la auditoría -----------------
# Sin esto, en Streamlit Cloud se pierde el refresh_token en cada reinicio.
[gsheets]
spreadsheet_id = "poner-el-id-de-la-planilla"

# En local, apuntando a un archivo:
# service_account_json_path = ".gsheets/sa.json"

# En Streamlit Cloud, pegar el contenido del JSON del service account:
# [gsheets.service_account]
# type = "service_account"
# project_id = "..."
# private_key_id = "..."
# private_key = "-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
# client_email = "...@....iam.gserviceaccount.com"
# client_id = "..."
# auth_uri = "https://accounts.google.com/o/oauth2/auth"
# token_uri = "https://oauth2.googleapis.com/token"
# auth_provider_x509_cert_url = "https://www.googleapis.com/oauth2/v1/certs"
# client_x509_cert_url = "..."


# --- Costos por SKU: vienen del sistema de Contabilidad ---------------
# Es OTRA planilla, distinta de la de [gsheets]. Los costos son netos SIN
# IVA y tienen vigencia por fecha. Ver costos_gsu.py.
#
# Si no se configura, las pantallas siguen andando pero hay que subir la
# planilla de costos a mano.
[gsheets_costos]
spreadsheet_id = "el-id-de-la-planilla-de-Contabilidad"
service_account_json_path = ".gsheets/sa.json"
# En Streamlit Cloud, pegar el JSON del service account:
# [gsheets_costos.service_account]
# type = "service_account"
# ...

# ---------------------------------------------------------------- Contabilium
#
# La lista de precios de venta, de donde sale el piso de las marcas propias
# (Costo x 1,85 para Suprabond, Bulit y Somerset). Sin esto las pantallas
# siguen andando, pero sin piso de marca.
#
# El client_id es el EMAIL del usuario administrador y el client_secret es la
# API Key, no la clave de acceso.

[contabilium]
client_id = "admin@tu-empresa.com.uy"
client_secret = "la-API-Key"
